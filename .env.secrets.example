# Copy to .env.secrets and fill in YOURSELF. Never commit, paste in chat, or let an agent save real values to any other file.
# Load for one session:  set -a; . ./.env.secrets; set +a
# Supabase personal access token (starts sbp_): lets scripts run SQL through the Management API. Revoke after use.
SUPABASE_ACCESS_TOKEN=
# Apify (LinkedIn/Indeed checks and company logos)
APIFY_TOKEN=
# TypeSafe Jev (requirement tiers, degree, family)
TYPESAFE_API_KEY=
# Shoo Google sign-in bridge (verify-shoo Edge Function): site origins the bridge accepts, comma-separated.
SHOO_APP_ORIGINS=
